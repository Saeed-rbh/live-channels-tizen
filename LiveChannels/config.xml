<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://livechannels.local/app" version="1.11.0" viewmodes="maximized">
  <tizen:application id="LiveChan01.LiveChannels" package="LiveChan01" required_version="6.5"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>Live Channels</name>
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" background-support="disable" hwkey-event="enable" context-menu="disable"/>
  <tizen:content-security-policy>default-src 'self'; script-src 'self' file:; connect-src http: https:; img-src 'self' https:; media-src http: https: blob:; object-src 'self'</tizen:content-security-policy>
</widget>
